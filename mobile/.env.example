# Base URL of the backend API (no trailing slash).
# Leave unset to auto-detect: the app uses the host machine running Metro on port 4000,
# which works for Expo Go on a physical device on the same Wi-Fi, iOS simulator and web.
# Android emulator: http://10.0.2.2:4000
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
