# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS ("*" allows all; fine for local dev only)
CORS_ORIGINS=*

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/feedants

# --- Auth ---
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Enables POST /api/v1/auth/dev-login (switch between seeded users). Never enable in production.
ENABLE_DEV_LOGIN=true

# --- Registration / payments ---
# How long a seat stays reserved while the user completes payment
SEAT_HOLD_MINUTES=10
# How often the background job releases expired seat holds
HOLD_SWEEP_INTERVAL_SECONDS=30
# "mock" simulates a Razorpay-style gateway (order -> payment -> HMAC signature verification)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-payment-secret

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

# --- Public URLs ---
# Used to build absolute URLs for uploaded files. Leave empty to derive from the request host.
PUBLIC_BASE_URL=
# Used to build referral links
REFERRAL_BASE_URL=https://feedants.com/r
